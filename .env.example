# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Production registration is closed by default.
# ALLOW_REGISTRATION=false

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai_video_studio?replicaSet=rs0

# Authentication uses random opaque sessions, hashed in MongoDB. No JWT secret.

# External AI Providers (API-First)
GEMINI_API_KEY=
# Choose a supported model with eligible API access; no model is selected implicitly.
GEMINI_MODEL=
# Optional comma-separated model choices. These never trigger automatic fallback.
GEMINI_ALTERNATE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
ELEVENLABS_API_KEY=
# One OpenRouter key enables both fixed :free models and the collaborative AI team.
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT_MS=90000
AI_TEAM_ENABLED=true
ELEVENLABS_MODEL=eleven_flash_v2_5
# Free CPU narration: piper-local (English/Hindi) or kitten-local (English).
NARRATION_PROVIDER=elevenlabs
LOCAL_TTS_PYTHON=.tts-venv/Scripts/python.exe
LOCAL_TTS_MODEL_DIR=storage/voices/kitten
ENABLE_HOSTED_VIDEO=false
ENABLE_FLOW_VIDEO=false
ENABLE_MOCK_PROVIDER=false
PROVIDER_TIMEOUT_MS=30000

# Storage Configuration
LOCAL_STORAGE_PATH=./storage
